{
  "manifest_version": 3,
  "name": "AI URL Trust Analyzer",
  "version": "1.0",
  "description": "AI-Powered URL Security Analyzer with Speedometer UI.",
  "action": {
    "default_popup": "index.html",
    "default_title": "AI URL Trust Analyzer"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
